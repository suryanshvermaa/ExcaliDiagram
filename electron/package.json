{
  "name": "excelidraw-desktop",
  "version": "1.0.0",
  "description": "ExcaliDiagram — local desktop app (Electron)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "ELECTRON_DEV_TOOLS=1 electron . --no-sandbox",
    "build:renderer": "cd ../app && pnpm run build",
    "build": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.excelidraw.desktop",
    "productName": "ExcaliDiagram",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../app/dist/**/*",
      "../backend/**/*",
      "!../backend/node_modules/.cache/**",
      "!../backend/.env",
      "!**/.git/**"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!.env"
        ]
      },
      {
        "from": "../app/dist",
        "to": "renderer"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
